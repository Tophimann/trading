//@version=5
// CISD-Definition: Referenz-Open ist das Open der extrembildenden Opposing-Serie
// (eine neue Opposing-Serie überschreibt das CISD-Level erst, wenn sie ein neues Swing-Extrem bildet).
// 1st iFVG: Erster entgegengesetzter 3-Kerzen-FVG, der auf oder nach der CISD-Bruchkerze per Close invertiert wird.
// Alle Signale und Alerts sind an barstate.isconfirmed (Bar-Close) gekoppelt (non-repainting).
indicator("Protected Swings mit CISD & 1st iFVG (Opposing Run) [SMC / ICT]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==========================================
// EINSTELLUNGEN (INPUTS)
// ==========================================
grp_swing = "Swing & CISD Einstellungen"
swing_left      = input.int(2, "Swing-Filter links (0 = Alle CISDs)", minval=0, maxval=50, group=grp_swing, tooltip="Wie viele Kerzen links vom Hoch/Tief niedriger/höher sein müssen. Kleinere Werte (z. B. 2) erkennen auch kurzfristige Swings ohne Pivot-Rechts-Lag. Equal Highs/Lows werden als gültiger Swing akzeptiert. CISD-Referenz ist das Open der extrembildenden Opposing-Serie. 0 = jeder CISD ohne Filter.")
max_swings      = input.int(5, "Anzahl angezeigter Protected Swings (0 = Max)", minval=0, maxval=250, group=grp_swing, tooltip="Wie viele Protected Swings (und zugehörige 1st iFVGs) maximal im Chart sichtbar bleiben sollen. Ältere werden automatisch gelöscht. 0 = Maximum innerhalb des TradingView-Limits (500 Boxen/Linien/Labels).")
separate_counts = input.bool(true, "Zählung getrennt für Highs & Lows", group=grp_swing, tooltip="Aktiv: Zeigt z. B. die letzten 5 Highs UND 5 Lows. Inaktiv: Zeigt die letzten 5 Swings insgesamt.")
show_label_txt  = input.bool(true, "Text 'CISD' am Ende der Linie anzeigen", group=grp_swing)

grp_ifvg = "1st Inversion FVG (iFVG) nach CISD"
show_ifvg       = input.bool(true, "1st iFVG nach CISD anzeigen", group=grp_ifvg, tooltip="Markiert den ersten entgegengesetzten 3-Kerzen-FVG, der auf oder nach einer CISD-Bruchkerze in CISD-Richtung per Close invertiert wird.")
show_ifvg_ce    = input.bool(true, "50% Midpoint (CE) Linie anzeigen", group=grp_ifvg)
show_ifvg_lbl   = input.bool(true, "Label '+iFVG' / '-iFVG' anzeigen", group=grp_ifvg)
ifvg_ext_mode   = input.string("Bis Mitigiert (Close)", "iFVG Verlängerung", options=["Bis Mitigiert (Close)", "Bis Mitigiert (Touch)", "Feste Balkenanzahl"], group=grp_ifvg, tooltip="Bis Mitigiert (Close): verlängert bis ein Close durch die Gegenseite der Zone bricht. Bis Mitigiert (Touch): verlängert bis Preis die Zone berührt. Feste Balkenanzahl: feste Breite nach Inversion.")
ifvg_max_bars   = input.int(50, "Max. Balken nach Inversion (0 = Unbegrenzt)", minval=0, maxval=500, group=grp_ifvg, tooltip="Im Modus 'Feste Balkenanzahl' die feste Breite nach der Inversionskerze; in den Mitigiert-Modi die maximale Verlängerung (0 = bis Mitigierung).")
color_bull_ifvg = input.color(color.new(#089981, 82), "Farbe: Bullish iFVG Box", group=grp_ifvg)
color_bear_ifvg = input.color(color.new(#f23645, 82), "Farbe: Bearish iFVG Box", group=grp_ifvg)
color_ifvg_ce   = input.color(color.new(#787B86, 30), "Farbe: 50% CE Linie", group=grp_ifvg)

grp_visual = "Visuelle Einstellungen & Anpassung"
dot_size_str = input.string("Tiny", "Punktgröße (Dot Size)", options=["Auto", "Tiny", "Small", "Normal", "Large", "Huge"], group=grp_visual, tooltip="Größe des Punktes am Protected High / Low")

line_len_mode = input.string("Bruchkerze + Extra Balken", "Linienlänge Modus", options=["Exakt bis Bruchkerze", "Bruchkerze + Extra Balken", "Unendlich nach rechts (Extend Right)"], group=grp_visual)
extra_bars    = input.int(0, "Zusätzliche Balken nach rechts (Extra Length)", minval=0, maxval=500, group=grp_visual, tooltip="Verlängert die CISD-Linie um X Kerzen über die Bruchkerze hinaus")

color_bull_dot  = input.color(color.new(#089981, 0), "Farbe: Punkt Protected Low", group=grp_visual)
color_bull_line = input.color(color.new(#089981, 10), "Farbe: Linie Bullischer CISD", group=grp_visual)
color_bear_dot  = input.color(color.new(#f23645, 0), "Farbe: Punkt Protected High", group=grp_visual)
color_bear_line = input.color(color.new(#f23645, 10), "Farbe: Linie Bärischer CISD", group=grp_visual)
line_width      = input.int(2, "Linienbreite", minval=1, maxval=4, group=grp_visual)
line_style_str  = input.string("Solid", "Linienstil", options=["Solid", "Dashed", "Dotted"], group=grp_visual)

// History-Puffer explizit absichern gegen dynamische Offset-Laufzeitfehler
const int MAX_HIST_BARS = 1000
max_bars_back(high, MAX_HIST_BARS)
max_bars_back(low, MAX_HIST_BARS)

get_line_style(string style) =>
    switch style
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

line_style = get_line_style(line_style_str)

get_dot_size(string s) =>
    switch s
        "Auto"   => size.auto
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.tiny

dot_size = get_dot_size(dot_size_str)

get_line_params(int break_bar) =>
    int x2 = break_bar
    string ext = extend.none
    if line_len_mode == "Unendlich nach rechts (Extend Right)"
        ext := extend.right
    else if line_len_mode == "Bruchkerze + Extra Balken"
        x2 := break_bar + extra_bars
    [x2, ext]

// Effektive Obergrenze passend zum TradingView-Limit (500 Boxen / 500 Linien / 500 Labels)
int lines_per_swing  = 1 + (show_ifvg and show_ifvg_ce ? 1 : 0)
int labels_per_swing = (show_label_txt ? 2 : 1) + (show_ifvg and show_ifvg_lbl ? 1 : 0)
int max_objects_per  = math.max(lines_per_swing, labels_per_swing)
int hard_cap         = separate_counts ? math.floor(500 / (max_objects_per * 2)) : math.floor(500 / max_objects_per)
int effective_max    = max_swings == 0 ? hard_cap : math.min(max_swings, hard_cap)

// ==========================================
// SPEICHER-QUEUES ZUR BEGRENZUNG DER ANZEIGE
// ==========================================
type Swing
    line  cisd_line
    label dot
    label txt

type FvgCand
    int   start_bar
    float top
    float bottom

type IfvgZone
    box   bx
    line  ce_line
    label lbl
    float top
    float bottom
    bool  is_bull
    bool  active
    int   inv_bar

var array<Swing>    all_swings  = array.new<Swing>()
var array<Swing>    bull_swings = array.new<Swing>()
var array<Swing>    bear_swings = array.new<Swing>()

var array<IfvgZone> all_ifvgs   = array.new<IfvgZone>()
var array<IfvgZone> bull_ifvgs  = array.new<IfvgZone>()
var array<IfvgZone> bear_ifvgs  = array.new<IfvgZone>()

var array<FvgCand>  bull_fvg_cands = array.new<FvgCand>()
var array<FvgCand>  bear_fvg_cands = array.new<FvgCand>()

const int MAX_FVG_CANDS = 50

delete_swing(Swing s) =>
    line.delete(s.cisd_line)
    label.delete(s.dot)
    if not na(s.txt)
        label.delete(s.txt)

register_swing(line l, label dot, label txt, bool is_bull) =>
    array<Swing> target_arr = separate_counts ? (is_bull ? bull_swings : bear_swings) : all_swings
    array.push(target_arr, Swing.new(l, dot, txt))
    while array.size(target_arr) > effective_max
        delete_swing(array.shift(target_arr))

delete_ifvg(IfvgZone z) =>
    box.delete(z.bx)
    if not na(z.ce_line)
        line.delete(z.ce_line)
    if not na(z.lbl)
        label.delete(z.lbl)

create_ifvg(int start_bar, float top_p, float bot_p, bool is_bull) =>
    float mid_p      = (top_p + bot_p) * 0.5
    color bg_col     = is_bull ? color_bull_ifvg : color_bear_ifvg
    color border_col = is_bull ? color_bull_line : color_bear_line
    bool  fixed_mode = ifvg_ext_mode == "Feste Balkenanzahl"
    int   x2         = fixed_mode ? bar_index + math.max(1, ifvg_max_bars) : bar_index
    box   bx         = box.new(start_bar, top_p, x2, bot_p, border_color=border_col, border_width=1, bgcolor=bg_col)
    line  ce         = show_ifvg_ce ? line.new(start_bar, mid_p, x2, mid_p, xloc=xloc.bar_index, extend=extend.none, color=color_ifvg_ce, style=line.style_dashed, width=1) : na
    label lb         = show_ifvg_lbl ? label.new(x2, mid_p, is_bull ? "+iFVG" : "-iFVG", xloc=xloc.bar_index, yloc=yloc.price, color=color(na), style=label.style_label_left, textcolor=border_col, size=size.small) : na
    array<IfvgZone> target_arr = separate_counts ? (is_bull ? bull_ifvgs : bear_ifvgs) : all_ifvgs
    array.push(target_arr, IfvgZone.new(bx, ce, lb, top_p, bot_p, is_bull, not fixed_mode, bar_index))
    while array.size(target_arr) > effective_max
        delete_ifvg(array.shift(target_arr))

update_active_ifvgs(array<IfvgZone> arr) =>
    int sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            IfvgZone z = array.get(arr, i)
            if z.active and bar_index > z.inv_bar
                box.set_right(z.bx, bar_index)
                if not na(z.ce_line)
                    line.set_x2(z.ce_line, bar_index)
                if not na(z.lbl)
                    label.set_x(z.lbl, bar_index)
                bool mitigated = ifvg_ext_mode == "Bis Mitigiert (Close)" ? (z.is_bull ? close < z.bottom : close > z.top) : (z.is_bull ? low <= z.top : high >= z.bottom)
                bool max_reached = ifvg_max_bars > 0 and (bar_index - z.inv_bar >= ifvg_max_bars)
                if mitigated or max_reached
                    z.active := false

// ==========================================
// HELPER: LOKALES SWING-HOCH / -TIEF PRÜFEN (OHNE RECHTS-LAG)
// ==========================================
// Hinweis: Bei Überschreitung des History-Puffers (MAX_HIST_BARS) verhält sich
// der Filter bewusst fail-closed (ok := false), da der Swing nicht prüfbar ist.
is_local_high(int target_bar, float target_high, int left_bars) =>
    bool ok = true
    if left_bars > 0
        int offset = bar_index - target_bar
        if offset >= 0
            for i = 1 to left_bars
                int idx = offset + i
                if idx > MAX_HIST_BARS
                    ok := false
                    break
                if idx > bar_index
                    break
                if high[idx] > target_high
                    ok := false
                    break
    ok

is_local_low(int target_bar, float target_low, int left_bars) =>
    bool ok = true
    if left_bars > 0
        int offset = bar_index - target_bar
        if offset >= 0
            for i = 1 to left_bars
                int idx = offset + i
                if idx > MAX_HIST_BARS
                    ok := false
                    break
                if idx > bar_index
                    break
                if low[idx] < target_low
                    ok := false
                    break
    ok

// ==========================================
// OPPOSING-RUN TRACKING (OHNE PIVOT-RECHTS-LAG, BAR-CLOSE BESTÄTIGT)
// ==========================================
var bool  bull_run_active   = false
var float bull_run_open     = na
var int   bull_run_bar      = na
var float bull_run_high     = na
var int   bull_run_high_bar = na
var float cand_bull_open    = na
var int   cand_bull_bar     = na

var bool  bear_run_active   = false
var float bear_run_open     = na
var int   bear_run_bar      = na
var float bear_run_low      = na
var int   bear_run_low_bar  = na
var float cand_bear_open    = na
var int   cand_bear_bar     = na

// Letzte nicht-Doji Kerzenrichtung (1 = bullisch, -1 = bärisch, 0 = initial).
// Dojis (close == open) werden neutral behandelt und resetten keinen Run.
var int last_dir = 0

// Suchstatus für 1st iFVG nach einem bestätigten CISD
var bool seek_bull_ifvg = false
var bool seek_bear_ifvg = false

bool bullish_cisd_triggered = false
bool bearish_cisd_triggered = false
bool bullish_ifvg_triggered = false
bool bearish_ifvg_triggered = false

if barstate.isconfirmed
    // Neue 3-Kerzen-FVG-Kandidaten erkennen (für spätere Inversion)
    if bar_index >= 2
        if high < low[2]
            array.push(bear_fvg_cands, FvgCand.new(bar_index - 2, low[2], high))
            while array.size(bear_fvg_cands) > MAX_FVG_CANDS
                array.shift(bear_fvg_cands)
        if low > high[2]
            array.push(bull_fvg_cands, FvgCand.new(bar_index - 2, low, high[2]))
            while array.size(bull_fvg_cands) > MAX_FVG_CANDS
                array.shift(bull_fvg_cands)

    // 0. EXTREM- & KANDIDATEN-UPDATE FÜR AKTIVE RUNS (VOR BRUCHPRÜFUNG)
    // Eine neue Opposing-Serie überschreibt das CISD-Referenz-Open erst dann,
    // wenn sie (oder eine direkt folgende Doji-/Wick-Kerze derselben Delivery)
    // tatsächlich ein neues Swing-Extrem erzeugt.
    if bull_run_active
        if close > open and last_dir != 1
            cand_bull_open := open
            cand_bull_bar  := bar_index
        if high > bull_run_high
            bull_run_high     := high
            bull_run_high_bar := bar_index
            if (close > open or last_dir == 1) and not na(cand_bull_open)
                bull_run_open := cand_bull_open
                bull_run_bar  := cand_bull_bar

    if bear_run_active
        if close < open and last_dir != -1
            cand_bear_open := open
            cand_bear_bar  := bar_index
        if low < bear_run_low
            bear_run_low     := low
            bear_run_low_bar := bar_index
            if (close < open or last_dir == -1) and not na(cand_bear_open)
                bear_run_open := cand_bear_open
                bear_run_bar  := cand_bear_bar

    // Prioritätsregel für Extremfälle (z. B. Gaps), falls beide Runs auf derselben
    // Kerze gebrochen würden: Kerzenrichtung entscheidet (bullisch -> Bull-CISD, bärisch -> Bear-CISD).
    bool bear_break = bull_run_active and close < bull_run_open
    bool bull_break = bear_run_active and close > bear_run_open
    if bear_break and bull_break
        if close > open
            bear_break := false
        else if close < open
            bull_break := false

    // 1. PRÜFEN OB AKTIVER BULLISCHER RUN GEBROCHEN WIRD (BEARISH CISD)
    if bear_break
        bull_run_active := false
        if is_local_high(bull_run_high_bar, bull_run_high, swing_left)
            bearish_cisd_triggered := true
            seek_bear_ifvg := true
            seek_bull_ifvg := false
            [target_x2, target_ext] = get_line_params(bar_index)
            new_l = line.new(bull_run_bar, bull_run_open, target_x2, bull_run_open, xloc.bar_index, target_ext, color_bear_line, line_style, line_width)
            label new_txt = show_label_txt ? label.new(target_x2, bull_run_open, "CISD", xloc.bar_index, yloc.price, color(na), label.style_none, color_bear_line, size.small) : na
            new_dot = label.new(bull_run_high_bar, bull_run_high, "", xloc.bar_index, yloc.abovebar, color_bear_dot, label.style_circle, color(na), dot_size, text.align_center, "Protected High")
            register_swing(new_l, new_dot, new_txt, false)
            alert(str.format("{0} {1}: Bearish CISD bestätigt @ {2} | CISD-Open: {3} | Protected High: {4}", syminfo.ticker, timeframe.period, str.tostring(close, format.mintick), str.tostring(bull_run_open, format.mintick), str.tostring(bull_run_high, format.mintick)), alert.freq_once_per_bar_close)

    // 2. PRÜFEN OB AKTIVER BÄRISCHER RUN GEBROCHEN WIRD (BULLISH CISD)
    if bull_break
        bear_run_active := false
        if is_local_low(bear_run_low_bar, bear_run_low, swing_left)
            bullish_cisd_triggered := true
            seek_bull_ifvg := true
            seek_bear_ifvg := false
            [target_x2, target_ext] = get_line_params(bar_index)
            new_l = line.new(bear_run_bar, bear_run_open, target_x2, bear_run_open, xloc.bar_index, target_ext, color_bull_line, line_style, line_width)
            label new_txt = show_label_txt ? label.new(target_x2, bear_run_open, "CISD", xloc.bar_index, yloc.price, color(na), label.style_none, color_bull_line, size.small) : na
            new_dot = label.new(bear_run_low_bar, bear_run_low, "", xloc.bar_index, yloc.belowbar, color_bull_dot, label.style_circle, color(na), dot_size, text.align_center, "Protected Low")
            register_swing(new_l, new_dot, new_txt, true)
            alert(str.format("{0} {1}: Bullish CISD bestätigt @ {2} | CISD-Open: {3} | Protected Low: {4}", syminfo.ticker, timeframe.period, str.tostring(close, format.mintick), str.tostring(bear_run_open, format.mintick), str.tostring(bear_run_low, format.mintick)), alert.freq_once_per_bar_close)

    // 3. NEUE OPPOSING RUNS STARTEN (WENN INAKTIV) & RICHTUNG MERKEN
    if close > open
        if not bull_run_active
            bull_run_active   := true
            bull_run_open     := open
            bull_run_bar      := bar_index
            bull_run_high     := high
            bull_run_high_bar := bar_index
            cand_bull_open    := open
            cand_bull_bar     := bar_index
        last_dir := 1
    else if close < open
        if not bear_run_active
            bear_run_active  := true
            bear_run_open    := open
            bear_run_bar     := bar_index
            bear_run_low     := low
            bear_run_low_bar := bar_index
            cand_bear_open   := open
            cand_bear_bar    := bar_index
        last_dir := -1

    // 4. 1ST INVERSION FVG (iFVG) NACH CISD PRÜFEN (INKL. CISD-BRUCHKERZE)
    // Bearish FVGs prüfen -> Inversion nach oben (close > top) = Bullish iFVG
    int bear_cands_sz = array.size(bear_fvg_cands)
    if bear_cands_sz > 0
        int   best_start = na
        float best_top   = na
        float best_bot   = na
        for i = bear_cands_sz - 1 to 0
            FvgCand c = array.get(bear_fvg_cands, i)
            if bar_index - c.start_bar > MAX_HIST_BARS
                array.remove(bear_fvg_cands, i)
            else if close > c.top
                if seek_bull_ifvg and (na(best_top) or c.top < best_top)
                    best_start := c.start_bar
                    best_top   := c.top
                    best_bot   := c.bottom
                array.remove(bear_fvg_cands, i)
        if not na(best_top)
            seek_bull_ifvg := false
            if show_ifvg
                bullish_ifvg_triggered := true
                create_ifvg(best_start, best_top, best_bot, true)
                alert(str.format("{0} {1}: 1st Bullish iFVG nach CISD @ {2} | Zone: {3} - {4}", syminfo.ticker, timeframe.period, str.tostring(close, format.mintick), str.tostring(best_bot, format.mintick), str.tostring(best_top, format.mintick)), alert.freq_once_per_bar_close)

    // Bullish FVGs prüfen -> Inversion nach unten (close < bottom) = Bearish iFVG
    int bull_cands_sz = array.size(bull_fvg_cands)
    if bull_cands_sz > 0
        int   best_start = na
        float best_top   = na
        float best_bot   = na
        for i = bull_cands_sz - 1 to 0
            FvgCand c = array.get(bull_fvg_cands, i)
            if bar_index - c.start_bar > MAX_HIST_BARS
                array.remove(bull_fvg_cands, i)
            else if close < c.bottom
                if seek_bear_ifvg and (na(best_bot) or c.bottom > best_bot)
                    best_start := c.start_bar
                    best_top   := c.top
                    best_bot   := c.bottom
                array.remove(bull_fvg_cands, i)
        if not na(best_bot)
            seek_bear_ifvg := false
            if show_ifvg
                bearish_ifvg_triggered := true
                create_ifvg(best_start, best_top, best_bot, false)
                alert(str.format("{0} {1}: 1st Bearish iFVG nach CISD @ {2} | Zone: {3} - {4}", syminfo.ticker, timeframe.period, str.tostring(close, format.mintick), str.tostring(best_bot, format.mintick), str.tostring(best_top, format.mintick)), alert.freq_once_per_bar_close)

    // 5. AKTIVE iFVG-BOXEN VERLÄNGERN / MITIGIEREN
    if show_ifvg
        if separate_counts
            update_active_ifvgs(bull_ifvgs)
            update_active_ifvgs(bear_ifvgs)
        else
            update_active_ifvgs(all_ifvgs)

// ==========================================
// ALARME (ALERTS)
// ==========================================
// Hinweis: Für dynamische Meldungen inkl. CISD-Open, Protected High/Low & iFVG-Zonen einen Alert
// auf "Any alert() function call" anlegen. Die alertcondition()-Einträge unten sind
// die statische Alternative – nicht beides gleichzeitig aktivieren (Doppel-Notifications).
alertcondition(bullish_cisd_triggered, title="Bullish CISD (Opposing Run)", message="{{ticker}} {{interval}} @ {{close}} – Bullish CISD bestätigt: Protected Low validiert!")
alertcondition(bearish_cisd_triggered, title="Bearish CISD (Opposing Run)", message="{{ticker}} {{interval}} @ {{close}} – Bearish CISD bestätigt: Protected High validiert!")
alertcondition(bullish_ifvg_triggered, title="1st Bullish iFVG nach CISD", message="{{ticker}} {{interval}} @ {{close}} – 1st Bullish iFVG nach CISD bestätigt!")
alertcondition(bearish_ifvg_triggered, title="1st Bearish iFVG nach CISD", message="{{ticker}} {{interval}} @ {{close}} – 1st Bearish iFVG nach CISD bestätigt!")
