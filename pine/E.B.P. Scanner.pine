//@version=6
indicator('MTF Engulfing Zones & STD', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ==================== 1. TIMEFRAMES ====================
const string grpTf = 'Timeframes (Visible on Current & Lower TF)'
bool   useTf1 = input.bool(true, 'TF 1', inline = 'tf1', group = grpTf)
string tf1    = input.timeframe('60', '', inline = 'tf1', group = grpTf)
bool   useTf2 = input.bool(true, 'TF 2', inline = 'tf2', group = grpTf)
string tf2    = input.timeframe('240', '', inline = 'tf2', group = grpTf)
bool   useTf3 = input.bool(false, 'TF 3', inline = 'tf3', group = grpTf)
string tf3    = input.timeframe('1D', '', inline = 'tf3', group = grpTf)

// ==================== 2. STANDARD DEVIATIONS ====================
const string grpStd = 'Standard Deviations (STD)'
bool  useStd1       = input.bool(true, 'STD 1', inline = 's1', group = grpStd)
float std1Val       = input.float(1.0, '', step = 0.1, minval = 0.1, inline = 's1', group = grpStd)
bool  useStd2       = input.bool(true, 'STD 2', inline = 's2', group = grpStd)
float std2Val       = input.float(1.5, '', step = 0.1, minval = 0.1, inline = 's2', group = grpStd)
bool  useStd3       = input.bool(true, 'STD 3', inline = 's3', group = grpStd)
float std3Val       = input.float(2.0, '', step = 0.1, minval = 0.1, inline = 's3', group = grpStd)
bool  showStdLabels = input.bool(true, 'Show STD Labels', group = grpStd)

// ==================== 3. LAYOUT & HISTORY ====================
const string grpStyle = 'Layout & History'
bool   showBull          = input.bool(true, 'Show Bullish Engulfing', group = grpStyle)
bool   showBear          = input.bool(true, 'Show Bearish Engulfing', group = grpStyle)
bool   showConfirmMarker = input.bool(true, 'Show LTF Confirm Triangle', group = grpStyle)
int    historyCount      = input.int(5, 'History (Engulfing Candles per TF)', minval = 1, maxval = 30, group = grpStyle)
int    boxWidthBars      = input.int(3, 'Box Width (in HTF Candles)', minval = 1, maxval = 50, group = grpStyle)
color  bullColor         = input.color(color.new(#4CAF50, 82), 'Bullish Box Color', group = grpStyle)
color  bearColor         = input.color(color.new(#F44336, 82), 'Bearish Box Color', group = grpStyle)
color  bullMarkerColor   = input.color(color.new(#4CAF50, 5), 'Bullish Confirm Triangle', group = grpStyle)
color  bearMarkerColor   = input.color(color.new(#F44336, 5), 'Bearish Confirm Triangle', group = grpStyle)
color  qColor            = input.color(color.new(#787B86, 25), 'Quartile Line Color', group = grpStyle)
string qStyleStr         = input.string('dashed', 'Quartile (25%/75%) Style', options = ['solid', 'dashed', 'dotted'], group = grpStyle)
string q50StyleStr       = input.string('solid', 'Midpoint (50%) Style', options = ['solid', 'dashed', 'dotted'], group = grpStyle)
color  stdColor          = input.color(color.new(#FF6D00, 15), 'STD Line Color', group = grpStyle)
string stdStyleStr       = input.string('dotted', 'STD Line Style', options = ['solid', 'dashed', 'dotted'], group = grpStyle)

// ==================== TYPES & HELPERS ====================
type Zone
    box   bx
    line  q25
    line  q50
    line  q75
    line  s1
    line  s2
    line  s3
    label lb1
    label lb2
    label lb3
    label marker
    int   right
    int   htfBarsLeft

f_lineStyle(string s) =>
    switch s
        'solid'  => line.style_solid
        'dashed' => line.style_dashed
        => line.style_dotted

string qStyle   = f_lineStyle(qStyleStr)
string q50Style = f_lineStyle(q50StyleStr)
string stdStyle = f_lineStyle(stdStyleStr)
int    chartSec = timeframe.in_seconds()

// Evaluates engulfing condition.
// usePrev = true evaluates the last closed bar [1] vs [2] (for non-repainting HTF requests).
f_engulfingTuple(simple bool usePrev) =>
    float oA = usePrev ? open[1]  : open
    float hA = usePrev ? high[1]  : high
    float lA = usePrev ? low[1]   : low
    float cA = usePrev ? close[1] : close
    float oB = usePrev ? open[2]  : open[1]
    float hB = usePrev ? high[2]  : high[1]
    float lB = usePrev ? low[2]   : low[1]
    float cB = usePrev ? close[2] : close[1]
    int   tA = usePrev ? time[1]  : time

    float prevBodyHigh = math.max(oB, cB)
    float prevBodyLow  = math.min(oB, cB)
    bool  rawBull      = lA < lB and cA > prevBodyHigh
    bool  rawBear      = hA > hB and cA < prevBodyLow
    bool  isBull       = rawBull and (not rawBear or cA >= oA)
    bool  isBear       = rawBear and (not rawBull or cA < oA)
    [tA, hA, lA, isBull, isBear]

// ==================== ZONE LIFECYCLE ====================
deleteZone(Zone z) =>
    if not na(z.bx)
        box.delete(z.bx)
    if not na(z.q25)
        line.delete(z.q25)
    if not na(z.q50)
        line.delete(z.q50)
    if not na(z.q75)
        line.delete(z.q75)
    if not na(z.s1)
        line.delete(z.s1)
    if not na(z.s2)
        line.delete(z.s2)
    if not na(z.s3)
        line.delete(z.s3)
    if not na(z.lb1)
        label.delete(z.lb1)
    if not na(z.lb2)
        label.delete(z.lb2)
    if not na(z.lb3)
        label.delete(z.lb3)
    if not na(z.marker)
        label.delete(z.marker)

setZoneRight(Zone z, int nextRight) =>
    z.right := nextRight
    if not na(z.bx)
        box.set_right(z.bx, nextRight)
    if not na(z.q25)
        line.set_x2(z.q25, nextRight)
    if not na(z.q50)
        line.set_x2(z.q50, nextRight)
    if not na(z.q75)
        line.set_x2(z.q75, nextRight)
    if not na(z.s1)
        line.set_x2(z.s1, nextRight)
    if not na(z.s2)
        line.set_x2(z.s2, nextRight)
    if not na(z.s3)
        line.set_x2(z.s3, nextRight)
    if not na(z.lb1)
        label.set_x(z.lb1, nextRight)
    if not na(z.lb2)
        label.set_x(z.lb2, nextRight)
    if not na(z.lb3)
        label.set_x(z.lb3, nextRight)

createZone(int x1, int x2, float topPrice, float botPrice, bool isBull, string tfTag, int htfBarsLeft, bool isHigherTf) =>
    float rng   = topPrice - botPrice
    float q25   = botPrice + rng * 0.25
    float q50   = botPrice + rng * 0.50
    float q75   = botPrice + rng * 0.75
    color bgCol = isBull ? bullColor : bearColor
    color noCol = color.new(color.black, 100)
    string loc  = isHigherTf ? xloc.bar_time : xloc.bar_index

    box  bxId  = box.new(x1, topPrice, x2, botPrice, xloc = loc, bgcolor = bgCol, border_color = noCol, border_width = 1)
    line q25Id = line.new(x1, q25, x2, q25, xloc = loc, color = qColor, style = qStyle, width = 1)
    line q50Id = line.new(x1, q50, x2, q50, xloc = loc, color = qColor, style = q50Style, width = 1)
    line q75Id = line.new(x1, q75, x2, q75, xloc = loc, color = qColor, style = qStyle, width = 1)

    float pStd1 = isBull ? topPrice + rng * std1Val : botPrice - rng * std1Val
    float pStd2 = isBull ? topPrice + rng * std2Val : botPrice - rng * std2Val
    float pStd3 = isBull ? topPrice + rng * std3Val : botPrice - rng * std3Val

    line s1Id = useStd1 ? line.new(x1, pStd1, x2, pStd1, xloc = loc, color = stdColor, style = stdStyle, width = 1) : na
    line s2Id = useStd2 ? line.new(x1, pStd2, x2, pStd2, xloc = loc, color = stdColor, style = stdStyle, width = 1) : na
    line s3Id = useStd3 ? line.new(x1, pStd3, x2, pStd3, xloc = loc, color = stdColor, style = stdStyle, width = 1) : na

    label lb1Id = useStd1 and showStdLabels ? label.new(x2, pStd1, tfTag + ' STD ' + str.tostring(std1Val), xloc = loc, color = noCol, style = label.style_label_left, textcolor = stdColor, size = size.small) : na
    label lb2Id = useStd2 and showStdLabels ? label.new(x2, pStd2, tfTag + ' STD ' + str.tostring(std2Val), xloc = loc, color = noCol, style = label.style_label_left, textcolor = stdColor, size = size.small) : na
    label lb3Id = useStd3 and showStdLabels ? label.new(x2, pStd3, tfTag + ' STD ' + str.tostring(std3Val), xloc = loc, color = noCol, style = label.style_label_left, textcolor = stdColor, size = size.small) : na

    // Confirmation triangle above HTF high (bullish) or below HTF low (bearish),
    // positioned at the confirming LTF candle (time)
    label markerId = na
    if showConfirmMarker and isHigherTf and not na(time)
        float  gap    = rng * 0.06
        float  mPrice = isBull ? topPrice + gap : botPrice - gap
        color  mCol   = isBull ? bullMarkerColor : bearMarkerColor
        string mGlyph = isBull ? '▲' : '▼'
        markerId := label.new(time[1], mPrice, mGlyph, xloc = xloc.bar_time, color = noCol, style = label.style_label_center, textcolor = mCol, size = size.normal)

    Zone.new(bxId, q25Id, q50Id, q75Id, s1Id, s2Id, s3Id, lb1Id, lb2Id, lb3Id, markerId, x2, htfBarsLeft)

// ==================== MANAGE ONE TIMEFRAME ====================
manageTf(bool enabled, string res, int htfT, float htfHi, float htfLo, bool htfBull, bool htfBear, int cT, float cHi, float cLo, bool cBull, bool cBear, array<Zone> zones, int prevTime) =>
    int newLastTime = prevTime
    int tfSec       = timeframe.in_seconds(res)
    string tfTag    = res == '' ? timeframe.period : res

    if enabled and not na(tfSec) and not na(chartSec) and tfSec > 0 and chartSec > 0 and tfSec >= chartSec
        bool isHigherTf = tfSec > chartSec

        if isHigherTf
            bool isNewHtfBar = not na(htfT) and (na(prevTime) or htfT != prevTime)

            if zones.size() > 0
                for i = 0 to zones.size() - 1
                    Zone z = zones.get(i)
                    if z.htfBarsLeft > 0
                        if time > z.right
                            setZoneRight(z, time)
                        if isNewHtfBar
                            z.htfBarsLeft -= 1

            if isNewHtfBar
                newLastTime := htfT
                if (htfBull and showBull) or (htfBear and showBear)
                    int x1            = htfT
                    int x2            = time > htfT ? time : htfT
                    int barsRemaining = math.max(0, boxWidthBars - 1)
                    zones.push(createZone(x1, x2, htfHi, htfLo, htfBull, tfTag, barsRemaining, true))
                    while zones.size() > historyCount
                        deleteZone(zones.shift())
        else
            bool isNewBar = barstate.isconfirmed and not na(cT) and (na(prevTime) or cT != prevTime)
            if isNewBar
                newLastTime := cT
                if (cBull and showBull) or (cBear and showBear)
                    int x1 = bar_index
                    int x2 = bar_index + boxWidthBars
                    zones.push(createZone(x1, x2, cHi, cLo, cBull, tfTag, 0, false))
                    while zones.size() > historyCount
                        deleteZone(zones.shift())

    newLastTime

// ==================== MTF DATA & STATE ====================
[cT, cHi, cLo, cBull, cBear]         = f_engulfingTuple(false)
[t1, hi1, lo1, bull1, bear1]         = request.security(syminfo.tickerid, tf1, f_engulfingTuple(true), barmerge.gaps_off, barmerge.lookahead_on)
[t2, hi2, lo2, bull2, bear2]         = request.security(syminfo.tickerid, tf2, f_engulfingTuple(true), barmerge.gaps_off, barmerge.lookahead_on)
[t3, hi3, lo3, bull3, bear3]         = request.security(syminfo.tickerid, tf3, f_engulfingTuple(true), barmerge.gaps_off, barmerge.lookahead_on)

var int         lastT1 = na
var int         lastT2 = na
var int         lastT3 = na
var array<Zone> zones1 = array.new<Zone>()
var array<Zone> zones2 = array.new<Zone>()
var array<Zone> zones3 = array.new<Zone>()

lastT1 := manageTf(useTf1, tf1, t1, hi1, lo1, bull1, bear1, cT, cHi, cLo, cBull, cBear, zones1, lastT1)
lastT2 := manageTf(useTf2, tf2, t2, hi2, lo2, bull2, bear2, cT, cHi, cLo, cBull, cBear, zones2, lastT2)
lastT3 := manageTf(useTf3, tf3, t3, hi3, lo3, bull3, bear3, cT, cHi, cLo, cBull, cBear, zones3, lastT3)
