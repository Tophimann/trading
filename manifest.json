{
  "manifest_version": 3,
  "name": "SubSphere - YouTube Subscription Organizer",
  "version": "1.0.0",
  "description": "Organize your YouTube subscriptions (Abonnements) into custom folders, build custom chronological feeds via RSS, and manually reorder channels.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SubSphere"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "dashboard.html",
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
